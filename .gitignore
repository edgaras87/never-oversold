# ======================================================================
# base layer — any repo, from day zero (records-only repos included)
# ======================================================================

# JetBrains IDE state — machine-local, never project truth
.idea/
*.iml

# OS scratch files
.DS_Store
Thumbs.db

# Logs
*.log

# Local secrets — .env.example is the committed shape; real values
# never enter history
.env

# Claude Code machine-local settings — permissions and local overrides;
# the committed shape (if any) is .claude/settings.json
.claude/settings.local.json

# The operator's standing instructions — one person, one checkout;
# the tool loads it beside CLAUDE.md but never ignores it on its own
CLAUDE.local.md

# ======================================================================
# stack overlays — appended below this line at app bootstrap
# ======================================================================

# Maven build output and the wrapper's downloaded jar — reproducible
# from the pom and the wrapper properties
target/
.mvn/wrapper/maven-wrapper.jar

# IDE state beyond the base layer (JetBrains project files, VS Code)
*.iws
*.ipr
.vscode/
