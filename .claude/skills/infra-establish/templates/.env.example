# Template — master copy in correctness-by-construction (ADR-0008);
# checked against concept v1 (ADR-0003, ADR-0005 — practice-born).
# Extracted 2026-08-28 from checkout-system's lived .env.example
# (PLAN Step 6). Changes on extraction: identities generalized to
# placeholders (<project>, uppercase <PROJECT> in the env key). The
# runtime-password key is the run's lived addition, harvested into
# the walkthrough this step (ADR-0007). Copy into a run and fill;
# the filled file is the run's own (ADR-0008).
# Harvested 2026-08-28: the runtime key renamed <PROJECT>_DB_PASSWORD
# → <PROJECT>_RUNTIME_PASSWORD — named for whose password it is, from
# safe-reservations' lived SAFE_RESERVATIONS_RUNTIME_PASSWORD
# (ADR-0007). application.yaml (cbc-bootstrap) reads the same key.

# Shape of .env (git-ignored). Copy to .env and fill. Local-dev
# placeholder values shown; real values never enter history.
# Decided identities (db, schema, roles) are NOT here — they are
# literal in compose.yaml and bootstrap.sql (changing one is a
# committed decision, not configuration).

# bootstrap identity's password (container's POSTGRES_PASSWORD)
POSTGRES_BOOTSTRAP_PASSWORD=postgres_localdev

# must equal the <project>_migrator password literal in
# infrastructure/postgres/init/bootstrap.sql
FLYWAY_MIGRATOR_PASSWORD=<project>_migrator_localdev

# host-side published port (machine variance)
POSTGRES_PORT=5432

# the application's identity (<project>_runtime) — must equal the
# runtime password literal in bootstrap.sql. The app reads it from the
# environment: `set -a; . ./.env; set +a` before running
<PROJECT>_RUNTIME_PASSWORD=<project>_runtime_localdev
