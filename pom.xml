<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The stack line is ADR-0007: Spring Boot 4, Java 21, Maven. The
         parent manages every version below unless a comment says why
         an entry pins its own. The Boot minor is pinned here and only
         here. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>io.github.edgaras87</groupId>
    <artifactId>never-oversold</artifactId>
    <!-- A version is a state of the evidence (CHANGELOG): 0.N while the
         registry's slices close, N the slices evidence-closed. No slice
         has closed. -->
    <version>0.0-SNAPSHOT</version>
    <name>never-oversold</name>
    <description>An inventory-reservation ledger in which the reserved quantity never exceeds the on-hand-count, however many reservations race for the same units.</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <!-- A dependency enters only at the step or slice that earns it, with
         its earning reason above it; groups are the capability served,
         runtime dependency first, its test companion right after. Boot 4
         pairs runtime starters with `-test` companions; where none
         exists, the runtime dependency stands alone. -->
    <dependencies>

        <!-- The door: the system answers HTTP, because adversity arrives
             through the real door — the evidence attacks what a caller
             reaches, never an inner method. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Operational health: a cheap world-is-up check every evidence run
             gates on; it names the store as a component once the store is
             wired. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Connectivity to the ground as `runtime`: the promise is a
             property of persisted state, so the system reaches the store
             — plain SQL inside transactions, at capability grain. No
             object mapping and no schema generation: nothing persists
             domain state yet, and structure is never the running
             application's to control (infrastructure contract). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The store's driver: PostgreSQL is the whole service set
             (ADR-0005). Runtime scope — nothing in the code names it. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- The evidence harness, test scope only: a throwaway store of the
             ground's major version, one per test JVM, so the suite is
             self-contained — a clean clone, the ground down, still green. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Migrations run harness-side against that store, as `migrator`,
             from the one home on the filesystem — the compose one-shot's
             role, played in tests. Test scope is load-bearing: at runtime
             scope the application could migrate, undoing the ground's
             constraint. Only the engine enters — not Boot's Flyway module —
             so no auto-configuration can run a migration inside the
             application context; the harness calls the engine itself. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Exists only to satisfy the test REST client's auto-configuration:
             on Boot 4 it introspects a builder from this separate module and
             the web test context dies without it, naming something else. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Repackages the jar as one runnable artifact and provides
                 `spring-boot:run`: the README's Run section and every
                 instance the evidence starts run this output. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Widens the test includes so the integration tests (`*IT`)
                 run under the one standard test command beside the unit
                 tests — no second command, no test that quietly never runs.
                 The first four patterns are Surefire's own defaults, restated
                 because setting includes replaces them. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
