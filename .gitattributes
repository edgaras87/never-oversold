# ======================================================================
# base layer — any repo, from day zero
# ======================================================================

# Set default behavior to automatically normalize line endings.
* text=auto eol=lf

# ======================================================================
# stack overlays — appended below this line at app bootstrap
# ======================================================================

# Maven wrapper: the shell script must stay LF, the Windows script CRLF
/mvnw text eol=lf
*.cmd text eol=crlf
